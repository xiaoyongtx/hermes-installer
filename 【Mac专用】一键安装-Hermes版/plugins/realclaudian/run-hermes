#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HERMES_REPO="${HERMES_REPO:-$SCRIPT_DIR}"
HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"

export HERMES_HOME
mkdir -p "$HERMES_HOME"

if [[ -x "$HERMES_REPO/.venv/bin/hermes" ]]; then
  HERMES_BIN="$HERMES_REPO/.venv/bin/hermes"
elif [[ -x "$HERMES_REPO/venv/bin/hermes" ]]; then
  HERMES_BIN="$HERMES_REPO/venv/bin/hermes"
elif command -v hermes >/dev/null 2>&1; then
  HERMES_BIN="$(command -v hermes)"
elif [[ -f "$HERMES_REPO/hermes" ]]; then
  HERMES_BIN="$HERMES_REPO/hermes"
else
  echo "Hermes executable not found." >&2
  echo "Set HERMES_REPO to your hermes-agent directory or install hermes on PATH." >&2
  exit 1
fi

exec "$HERMES_BIN" "$@"
