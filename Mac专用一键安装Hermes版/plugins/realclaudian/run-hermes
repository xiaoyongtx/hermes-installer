#!/usr/bin/env bash
set -euo pipefail

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
mkdir -p "$HERMES_HOME"

# 0. 优先查找 hermes-agent venv 安装（安装脚本放在 $HERMES_HOME/hermes-agent/venv）
if [[ -x "$HERMES_HOME/hermes-agent/venv/bin/hermes" ]]; then
  HERMES_BIN="$HERMES_HOME/hermes-agent/venv/bin/hermes"
# 1. 检查 PATH 中的 hermes
elif command -v hermes >/dev/null 2>&1; then
  HERMES_BIN="$(command -v hermes)"
# 2. 检查 Hermes 桌面版（macOS .app 内置 CLI）
elif [[ -x "/Applications/Hermes Agent CN Desktop.app/Contents/MacOS/hermes" ]]; then
  HERMES_BIN="/Applications/Hermes Agent CN Desktop.app/Contents/MacOS/hermes"
elif [[ -x "$HOME/Applications/Hermes Agent CN Desktop.app/Contents/MacOS/hermes" ]]; then
  HERMES_BIN="$HOME/Applications/Hermes Agent CN Desktop.app/Contents/MacOS/hermes"
# 3. 检查 HERMES_REPO 环境变量
elif [[ -n "${HERMES_REPO:-}" && -x "$HERMES_REPO/venv/bin/hermes" ]]; then
  HERMES_BIN="$HERMES_REPO/venv/bin/hermes"
elif [[ -n "${HERMES_REPO:-}" && -x "$HERMES_REPO/.venv/bin/hermes" ]]; then
  HERMES_BIN="$HERMES_REPO/.venv/bin/hermes"
# 4. 检查脚本同目录下的传统 venv 安装
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -x "$SCRIPT_DIR/.venv/bin/hermes" ]]; then
    HERMES_BIN="$SCRIPT_DIR/.venv/bin/hermes"
  elif [[ -x "$SCRIPT_DIR/venv/bin/hermes" ]]; then
    HERMES_BIN="$SCRIPT_DIR/venv/bin/hermes"
  elif [[ -f "$SCRIPT_DIR/hermes" ]]; then
    HERMES_BIN="$SCRIPT_DIR/hermes"
  else
    echo "Hermes executable not found." >&2
    echo "Tried:" >&2
    echo "  - \$HERMES_HOME/hermes-agent/venv/bin/hermes" >&2
    echo "  - hermes in PATH" >&2
    echo "  - Hermes Desktop .app bundles" >&2
    echo "  - \$HERMES_REPO/venv/bin/hermes" >&2
    echo "  - \$SCRIPT_DIR/venv/bin/hermes" >&2
    echo "" >&2
    echo "Install Hermes Desktop from https://desktop.hermesagent.org.cn/" >&2
    echo "Or set HERMES_REPO to your hermes-agent directory." >&2
    exit 1
  fi
fi

exec "$HERMES_BIN" "$@"
